{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beyt",
  "version": "0.17.0",
  "identifier": "app.beyt.player",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Beyt",
        "width": 1280,
        "height": 720,
        "minWidth": 480,
        "minHeight": 320,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/vocab-media/**",
          "$APPCACHE/thumbnails/**"
        ]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
