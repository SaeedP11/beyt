    "dev:gateway": "VITE_BEYT_GATEWAY=http://127.0.0.1:8787/beyt/v1 VITE_BEYT_TOKEN=beyt-dev-token-0000 VITE_BEYT_SOURCES=demo:Demo\\ FTP vite"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vazirmatn": "^33.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vite": "^8.3.4"
  },
  "main": "./dist-lib/beyt.js",
